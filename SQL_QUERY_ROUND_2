SELECT
    date, resource_id,
    MIN(
    CASE 
        WHEN is_clock_in = 1 THEN start_time
    END
) AS Clock_in_time,
MAX(
    CASE 
        WHEN is_clock_out = 1 THEN end_time
    END
) AS clock_out_time,
    SUM(
        (strftime('%s', end_time) - strftime('%s', start_time)) / 3600.0
    ) AS total_working_hours
FROM test_de
GROUP BY
    date,
    resource_id
ORDER BY
    resource_id,
    date;
